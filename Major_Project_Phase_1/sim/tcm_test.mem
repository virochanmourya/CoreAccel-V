// CoreAccel-V TCM Stress Test — catches BRAM read latency bugs
// KEY: Test 3 uses ADDI x20,x0,99 immediately before LW from TCM.
// x20's ALU result (99) is NOT a valid TCM address. If the BRAM
// reads using MEM-stage address (wrong), it gets stale data.
// If it reads using EX-stage address (correct), it works.

// ============================================================
// SETUP
// ============================================================
// [0x00] LUI x2, 0x80000            — x2 = 0x80000000
80000137
// [0x04] ADDI x1, x0, 7             — x1 = 7
00700093
// [0x08] SW x1, 0(x2)               — TCM[0] = 7
00112023
// [0x0C] ADDI x14, x0, 13           — x14 = 13
00D00713
// [0x10] SW x14, 4(x2)              — TCM[1] = 13
00E12223

// ============================================================
// TEST 1: Basic TCM write + read-back
// ============================================================
// [0x14] NOP
00000013
// [0x18] NOP
00000013
// [0x1C] LW x3, 0(x2)               — x3 = 7
00012183

// ============================================================
// TEST 2: MAC via TCM Port B (6 * 7 = 42)
// ============================================================
// [0x20] ADDI x4, x0, 6             — x4 = 6
00600213
// [0x24] MAC_CLEAR
0000100B
// [0x28] ADDI x5, x0, 0             — x5 = 0 (TCM byte addr word 0)
00000293
// [0x2C] MAC x0, x4, x5             — ACC += 6 * TCM[0] = 42
0052000B
// [0x30] NOP
00000013
// [0x34] NOP
00000013
// [0x38] NOP
00000013
// [0x3C] NOP
00000013
// [0x40] MAC_READ_LO x6             — x6 = 42
0000330B

// ============================================================
// TEST 3: BRAM LATENCY STRESS — LW from TCM after unrelated ALU op
// The instruction BEFORE the LW has ALU result = 99 (0x63).
// If TCM reads using MEM-stage address, it would read from
// word 99>>2=24 (garbage). Only EX-stage addressing works.
// ============================================================
// [0x44] NOP
00000013
// [0x48] ADDI x20, x0, 99           — x20 = 99 (POISON the ALU result)
06300A13
// [0x4C] LW x15, 4(x2)              — x15 = TCM[1] = 13
00412783
// [0x50] NOP
00000013
// [0x54] NOP
00000013

// ============================================================
// TEST 4: Cross-port RAW (write TCM[2] then MAC reads it)
// ============================================================
// [0x58] ADDI x7, x0, 11            — x7 = 11
00B00393
// [0x5C] SW x7, 8(x2)               — TCM[2] = 11
00712423
// [0x60] NOP
00000013
// [0x64] NOP
00000013
// [0x68] ADDI x8, x0, 3             — x8 = 3
00300413
// [0x6C] MAC_CLEAR
0000100B
// [0x70] ADDI x9, x0, 8             — x9 = 8 (TCM byte addr for word 2)
00800493
// [0x74] MAC x0, x8, x9             — ACC += 3 * TCM[2] = 33
0094000B
// [0x78] NOP
00000013
// [0x7C] NOP
00000013
// [0x80] NOP
00000013
// [0x84] NOP
00000013
// [0x88] MAC_READ_LO x10            — x10 = 33
0000350B

// ============================================================
// TEST 5: MAC stall survival
// ============================================================
// [0x8C] ADDI x11, x0, 100          — x11 = 100 (canary)
06400593
// [0x90] MAC_CLEAR
0000100B
// [0x94] MAC x0, x4, x5             — ACC += 6*TCM[0] = 42
0052000B
// [0x98] ADDI x11, x0, 55           — x11 = 55 (must survive stall)
03700593
// [0x9C] NOP
00000013
// [0xA0] NOP
00000013
// [0xA4] NOP
00000013
// [0xA8] NOP
00000013
// [0xAC] MAC_READ_LO x12            — x12 = 42
0000360B

// ============================================================
// TEST 6: Multi-accumulate (6*7 + 3*11 = 75)
// ============================================================
// [0xB0] MAC_CLEAR
0000100B
// [0xB4] MAC x0, x4, x5             — ACC += 6*7 = 42
0052000B
// [0xB8] NOP
00000013
// [0xBC] NOP
00000013
// [0xC0] NOP
00000013
// [0xC4] NOP
00000013
// [0xC8] MAC x0, x8, x9             — ACC += 3*11 = 42+33 = 75
0094000B
// [0xCC] NOP
00000013
// [0xD0] NOP
00000013
// [0xD4] NOP
00000013
// [0xD8] NOP
00000013
// [0xDC] MAC_READ_LO x13            — x13 = 75
0000368B

// ============================================================
// DRAIN
// ============================================================
// [0xE0] NOP
00000013
// [0xE4] NOP
00000013
// [0xE8] NOP
00000013
// [0xEC] NOP
00000013
// [0xF0] NOP
00000013
